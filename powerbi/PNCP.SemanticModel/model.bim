        ],
        "partitions": [
          {
            "name": "fato_item_contratado",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let Fonte = PostgreSQL.Database(\"localhost:5432\", \"pncp_controladoria\", [CreateNavigationProperties=false]), Dados = Fonte{[Schema=\"public\",Item=\"fato_item_contratado\"]}[Data] in Dados"
            }
          }
        ]
      },
      {
        "name": "Calendario",
        "dataCategory": "Time",
        "columns": [
          {
            "name": "Data",
            "dataType": "dateTime",
            "sourceColumn": "[Date]",
            "type": "calculatedTableColumn",
            "isKey": true,
            "formatString": "dd/MM/yyyy",
            "summarizeBy": "none"
          },
          {
            "name": "Ano",
            "dataType": "int64",
            "sourceColumn": "[Ano]",
            "type": "calculatedTableColumn",
            "summarizeBy": "none"
          },
          {
            "name": "MesNumero",
            "dataType": "int64",
            "sourceColumn": "[MesNumero]",
            "type": "calculatedTableColumn",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Mes",
            "dataType": "string",
            "sourceColumn": "[Mes]",
            "type": "calculatedTableColumn",
            "summarizeBy": "none",
            "sortByColumn": "MesNumero"
          },
          {
            "name": "AnoMes",
            "dataType": "string",
            "sourceColumn": "[AnoMes]",
            "type": "calculatedTableColumn",
            "summarizeBy": "none",
            "sortByColumn": "AnoMesOrdem"
          },
          {
            "name": "AnoMesOrdem",
            "dataType": "int64",
            "sourceColumn": "[AnoMesOrdem]",
            "type": "calculatedTableColumn",
            "summarizeBy": "none",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "Calendario",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "VAR Datas = UNION(SELECTCOLUMNS(fato_item_contratado,\"D\",fato_item_contratado[data_publicacao]),SELECTCOLUMNS(FILTER(fato_item_contratado,NOT ISBLANK(fato_item_contratado[data_homologacao])),\"D\",fato_item_contratado[data_homologacao]))\nVAR Inicio = MINX(Datas,[D])\nVAR Fim = MAXX(Datas,[D])\nRETURN ADDCOLUMNS(CALENDAR(Inicio,Fim),\"Ano\",YEAR([Date]),\"MesNumero\",MONTH([Date]),\"Mes\",FORMAT([Date],\"mmm\",\"pt-BR\"),\"AnoMes\",FORMAT([Date],\"yyyy-MM\"),\"AnoMesOrdem\",YEAR([Date])*100+MONTH([Date]))"
            }
          }
        ]
      },
      {
        "name": "Medidas",
        "columns": [
          {
            "name": "Oculta",
            "dataType": "int64",
            "sourceColumn": "[Value]",
            "type": "calculatedTableColumn",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "Medidas",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "{ 0 }"
            }
          }
        ],
        "measures": [
          {
            "name": "Valor Estimado Comparável",
            "expression": "CALCULATE(SUM(fato_item_contratado[valor_total_estimado]),fato_item_contratado[comparavel]=1)",
            "displayFolder": "P1 Economia",
            "formatString": "#,0.00"
          },
          {
            "name": "Volume Homologado",
            "expression": "SUM(fato_item_contratado[valor_total_homologado])",
            "displayFolder": "P1 Economia",
            "formatString": "#,0.00"
          },
          {
            "name": "Economia R$",
            "expression": "VAR Estimado = [Valor Estimado Comparável]\nVAR Homologado = CALCULATE([Volume Homologado],fato_item_contratado[comparavel]=1)\nRETURN IF(ISBLANK(Estimado),BLANK(),Estimado-Homologado)",
            "displayFolder": "P1 Economia",
            "formatString": "#,0.00"
          },
          {
            "name": "Economia %",
            "expression": "DIVIDE([Economia R$],[Valor Estimado Comparável])",
            "displayFolder": "P1 Economia",
            "formatString": "0.00%"
          },
          {
            "name": "Itens",
            "expression": "COUNTROWS(fato_item_contratado)",
            "displayFolder": "P1 Economia",
            "formatString": "#,0"
          },
          {
            "name": "% Itens Comparáveis",
            "expression": "DIVIDE(CALCULATE([Itens],fato_item_contratado[comparavel]=1),[Itens])",
            "displayFolder": "P1 Economia",
            "formatString": "0.00%"
          },
          {
            "name": "Participação Fornecedor %",
            "expression": "DIVIDE([Volume Homologado],CALCULATE([Volume Homologado],REMOVEFILTERS(dim_fornecedor)))",
            "displayFolder": "P2 Fornecedores",
            "formatString": "0.00%"
          },
          {
            "name": "Ranking Fornecedor",
            "expression": "RANKX(ALL(dim_fornecedor),[Volume Homologado],,DESC,Dense)",
            "displayFolder": "P2 Fornecedores",
            "formatString": "0"
          },
          {
            "name": "Concentração Top10 %",
            "expression": "VAR Top10 = TOPN(10,ALL(dim_fornecedor),[Volume Homologado],DESC,dim_fornecedor[ni_fornecedor],ASC)\nVAR VolumeTop = CALCULATE([Volume Homologado],REMOVEFILTERS(dim_fornecedor),Top10)\nVAR Total = CALCULATE([Volume Homologado],REMOVEFILTERS(dim_fornecedor))\nRETURN DIVIDE(VolumeTop,Total)",
            "displayFolder": "P2 Fornecedores",
            "formatString": "0.00%"
          },
          {
            "name": "Volume Top10",
            "expression": "VAR Top10 = TOPN(10,ALL(dim_fornecedor),[Volume Homologado],DESC,dim_fornecedor[ni_fornecedor],ASC) RETURN CALCULATE([Volume Homologado],KEEPFILTERS(Top10))",
            "displayFolder": "P2 Fornecedores",
            "formatString": "#,0.00"
          },
          {
            "name": "Participação Volume %",
            "expression": "VAR Total = SWITCH(TRUE(),ISINSCOPE(dim_modalidade[nome_modalidade]),CALCULATE([Volume Homologado],REMOVEFILTERS(dim_modalidade)),ISINSCOPE(dim_localidade[uf_sigla]),CALCULATE([Volume Homologado],REMOVEFILTERS(dim_localidade[uf_sigla])),ISINSCOPE(dim_localidade[regiao]),CALCULATE([Volume Homologado],REMOVEFILTERS(dim_localidade)),ISINSCOPE(fato_item_contratado[perfil_gasto]),CALCULATE([Volume Homologado],REMOVEFILTERS(fato_item_contratado[perfil_gasto])),CALCULATE([Volume Homologado],REMOVEFILTERS())) RETURN DIVIDE([Volume Homologado],Total)",
            "displayFolder": "P3 Modalidades",
            "formatString": "0.00%"
          },
          {
            "name": "Deságio vs Média Geral pp",
            "expression": "VAR MediaGeral = CALCULATE([Economia %],REMOVEFILTERS()) RETURN IF(NOT ISBLANK([Economia %]),([Economia %]-MediaGeral)*100)",
            "displayFolder": "P3 Modalidades",
            "formatString": "0.00 \"pp\""
          },
          {
            "name": "Ciclo Médio (dias)",
            "expression": "AVERAGE(fato_item_contratado[dias_ciclo])",
            "displayFolder": "P4 Ciclos",
            "formatString": "0.0"
          },
          {
            "name": "Ciclo Máximo (dias)",
            "expression": "MAX(fato_item_contratado[dias_ciclo])",
            "displayFolder": "P4 Ciclos",
            "formatString": "0"
          },
          {
            "name": "Itens sem Ciclo",
            "expression": "COUNTROWS(FILTER(fato_item_contratado,ISBLANK(fato_item_contratado[dias_ciclo])))",
            "displayFolder": "P4 Ciclos",
            "formatString": "#,0"
          },
          {
            "name": "Ciclos Válidos",
            "expression": "COUNT(fato_item_contratado[dias_ciclo])",
            "displayFolder": "P4 Ciclos",
            "formatString": "#,0"
          },
          {
            "name": "Ciclo Médio Elegível",
            "expression": "IF([Ciclos Válidos]>=5,[Ciclo Médio (dias)])",
            "displayFolder": "P4 Ciclos",
            "formatString": "0.0"
          },
          {
            "name": "Qtd Unidades Compradoras",
            "expression": "DISTINCTCOUNT(fato_item_contratado[sk_orgao])",
            "displayFolder": "P5 Território",
            "formatString": "#,0"
          },
          {
            "name": "Ticket Médio por Item",
            "expression": "DIVIDE([Volume Homologado],[Itens])",
            "displayFolder": "P6 Perfis",
            "formatString": "#,0.00"
          },
          {
            "name": "Itens com Sobrepreço",
            "expression": "COUNTROWS(FILTER(fato_item_contratado,fato_item_contratado[comparavel]=1 && fato_item_contratado[economia_valor]<0))",
            "displayFolder": "P1 Economia",
            "formatString": "#,0"
          },
          {
            "name": "Volume por Homologação",
            "expression": "CALCULATE([Volume Homologado],USERELATIONSHIP(Calendario[Data],fato_item_contratado[data_homologacao]))",
            "displayFolder": "Datas alternativas",
            "formatString": "#,0.00"
          },
          {
            "name": "Título Tooltip",
            "expression": "COALESCE(SELECTEDVALUE(dim_fornecedor[nome_fornecedor]),SELECTEDVALUE(dim_modalidade[nome_modalidade]),SELECTEDVALUE(dim_localidade[uf_sigla]),SELECTEDVALUE(fato_item_contratado[perfil_gasto]),\"Detalhes do recorte\")",
            "displayFolder": "Tooltip",
            "formatString": ""
          }
        ]
      }
    ],
    "relationships": [
      {
