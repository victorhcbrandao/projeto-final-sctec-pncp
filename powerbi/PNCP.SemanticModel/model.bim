            "sourceColumn": "[Date]",
            "summarizeBy": "none",
            "type": "calculatedTableColumn"
          },
          {
            "name": "Ano",
            "dataType": "int64",
            "isNameInferred": false,
            "lineageTag": "45ad8bb7-de25-46aa-af2d-cacdd8ee36fc",
            "sourceColumn": "[Ano]",
            "summarizeBy": "none",
            "type": "calculatedTableColumn"
          },
          {
            "name": "MesNumero",
            "dataType": "int64",
            "isHidden": true,
            "isNameInferred": false,
            "lineageTag": "8e3cba5d-9cac-4c07-8a4e-6a6014aa5f38",
            "sourceColumn": "[MesNumero]",
            "summarizeBy": "none",
            "type": "calculatedTableColumn"
          },
          {
            "name": "Mes",
            "dataType": "string",
            "isNameInferred": false,
            "lineageTag": "4747bd07-f8a0-4c27-bd3b-635ad555640c",
            "sortByColumn": "MesNumero",
            "sourceColumn": "[Mes]",
            "summarizeBy": "none",
            "type": "calculatedTableColumn"
          },
          {
            "name": "AnoMes",
            "dataType": "string",
            "isNameInferred": false,
            "lineageTag": "9bec4460-a72b-405b-8774-55dcf793a44c",
            "sortByColumn": "AnoMesOrdem",
            "sourceColumn": "[AnoMes]",
            "summarizeBy": "none",
            "type": "calculatedTableColumn"
          },
          {
            "name": "AnoMesOrdem",
            "dataType": "int64",
            "isHidden": true,
            "isNameInferred": false,
            "lineageTag": "259a68b5-40d9-4179-a0c0-5b4ccfc5f8f0",
            "sourceColumn": "[AnoMesOrdem]",
            "summarizeBy": "none",
            "type": "calculatedTableColumn"
          }
        ],
        "dataCategory": "Time",
        "lineageTag": "02262ee5-11fb-42a0-b617-4f1ad85be3c5",
        "partitions": [
          {
            "name": "Calendario",
            "mode": "import",
            "source": {
              "expression": [
                "VAR Datas = UNION(SELECTCOLUMNS(fato_item_contratado,\"D\",fato_item_contratado[data_publicacao]),SELECTCOLUMNS(FILTER(fato_item_contratado,NOT ISBLANK(fato_item_contratado[data_homologacao])),\"D\",fato_item_contratado[data_homologacao]))",
                "VAR Inicio = MINX(Datas,[D])",
                "VAR Fim = MAXX(Datas,[D])",
                "RETURN ADDCOLUMNS(CALENDAR(Inicio,Fim),\"Ano\",YEAR([Date]),\"MesNumero\",MONTH([Date]),\"Mes\",FORMAT([Date],\"mmm\",\"pt-BR\"),\"AnoMes\",FORMAT([Date],\"yyyy-MM\"),\"AnoMesOrdem\",YEAR([Date])*100+MONTH([Date]))"
              ],
              "type": "calculated"
            }
          }
        ]
      },
      {
        "name": "Medidas",
        "columns": [
          {
            "name": "Oculta",
            "dataType": "int64",
            "isHidden": true,
            "isNameInferred": false,
            "lineageTag": "15e3089d-0d94-4a9f-b359-d0615f58d608",
            "sourceColumn": "[Value]",
            "type": "calculatedTableColumn"
          }
        ],
        "lineageTag": "3074f8f9-dab7-465c-985e-a63e92a562a7",
        "measures": [
          {
            "name": "Valor Estimado Comparável",
            "displayFolder": "P1 Economia",
            "expression": "CALCULATE(SUM(fato_item_contratado[valor_total_estimado]),fato_item_contratado[comparavel]=1)",
            "formatString": "#,0.00",
            "lineageTag": "2386612e-0d54-4ff5-8888-2252af87d847"
          },
          {
            "name": "Volume Homologado",
            "displayFolder": "P1 Economia",
            "expression": "SUM(fato_item_contratado[valor_total_homologado])",
            "formatString": "#,0.00",
            "lineageTag": "0f3a192d-82ac-41f3-849e-5584b11486a9"
          },
          {
            "name": "Economia R$",
            "displayFolder": "P1 Economia",
            "expression": [
              "VAR Estimado = [Valor Estimado Comparável]",
              "VAR Homologado = CALCULATE([Volume Homologado],fato_item_contratado[comparavel]=1)",
              "RETURN IF(ISBLANK(Estimado),BLANK(),Estimado-Homologado)"
            ],
            "formatString": "#,0.00",
            "lineageTag": "2fd287fa-93cb-46b5-8100-d7c30bd5d481"
          },
          {
            "name": "Economia %",
            "displayFolder": "P1 Economia",
            "expression": "DIVIDE([Economia R$],[Valor Estimado Comparável])",
            "formatString": "0.00%",
            "lineageTag": "2ce12d6c-edf2-47a6-9716-acd304be5614"
          },
          {
            "name": "Itens",
            "displayFolder": "P1 Economia",
            "expression": "COUNTROWS(fato_item_contratado)",
            "formatString": "#,0",
            "lineageTag": "676a1587-acde-4257-9522-5820f58f504d"
          },
          {
            "name": "% Itens Comparáveis",
            "displayFolder": "P1 Economia",
            "expression": "DIVIDE(CALCULATE([Itens],fato_item_contratado[comparavel]=1),[Itens])",
            "formatString": "0.00%",
            "lineageTag": "6d9e96fb-0bc6-487a-b454-93302a3b2f84"
          },
          {
            "name": "Participação Fornecedor %",
            "displayFolder": "P2 Fornecedores",
            "expression": "DIVIDE([Volume Homologado],CALCULATE([Volume Homologado],REMOVEFILTERS(dim_fornecedor)))",
            "formatString": "0.00%",
            "lineageTag": "5ad5b788-0540-409c-9dd1-ff413e866a14"
          },
          {
            "name": "Ranking Fornecedor",
            "displayFolder": "P2 Fornecedores",
            "expression": "RANKX(ALL(dim_fornecedor),[Volume Homologado],,DESC,Dense)",
            "formatString": "0",
            "lineageTag": "71739757-56a7-4c04-99e2-459ab9709f11"
          },
          {
            "name": "Concentração Top10 %",
            "displayFolder": "P2 Fornecedores",
            "expression": [
              "VAR Top10 = TOPN(10,ALL(dim_fornecedor),[Volume Homologado],DESC,dim_fornecedor[ni_fornecedor],ASC)",
              "VAR VolumeTop = CALCULATE([Volume Homologado],REMOVEFILTERS(dim_fornecedor),Top10)",
              "VAR Total = CALCULATE([Volume Homologado],REMOVEFILTERS(dim_fornecedor))",
              "RETURN DIVIDE(VolumeTop,Total)"
            ],
            "formatString": "0.00%",
            "lineageTag": "71b0dce9-e7bf-4e2d-89e3-0d9aea5a762d"
          },
          {
            "name": "Volume Top10",
            "displayFolder": "P2 Fornecedores",
            "expression": "VAR Top10 = TOPN(10,ALL(dim_fornecedor),[Volume Homologado],DESC,dim_fornecedor[ni_fornecedor],ASC) RETURN CALCULATE([Volume Homologado],KEEPFILTERS(Top10))",
            "formatString": "#,0.00",
            "lineageTag": "d527830e-c5de-40c2-9db1-162399f71fc9"
          },
          {
            "name": "Participação Volume %",
            "displayFolder": "P3 Modalidades",
            "expression": "VAR Total = SWITCH(TRUE(),ISINSCOPE(dim_modalidade[nome_modalidade]),CALCULATE([Volume Homologado],REMOVEFILTERS(dim_modalidade)),ISINSCOPE(dim_localidade[uf_sigla]),CALCULATE([Volume Homologado],REMOVEFILTERS(dim_localidade[uf_sigla])),ISINSCOPE(dim_localidade[regiao]),CALCULATE([Volume Homologado],REMOVEFILTERS(dim_localidade)),ISINSCOPE(fato_item_contratado[perfil_gasto]),CALCULATE([Volume Homologado],REMOVEFILTERS(fato_item_contratado[perfil_gasto])),CALCULATE([Volume Homologado],REMOVEFILTERS())) RETURN DIVIDE([Volume Homologado],Total)",
            "formatString": "0.00%",
            "lineageTag": "075b2367-0c64-459b-a7aa-9e676411c278"
          },
          {
            "name": "Deságio vs Média Geral pp",
            "displayFolder": "P3 Modalidades",
            "expression": "VAR MediaGeral = CALCULATE([Economia %],REMOVEFILTERS()) RETURN IF(NOT ISBLANK([Economia %]),([Economia %]-MediaGeral)*100)",
            "formatString": "0.00 \"pp\"",
            "lineageTag": "eee4ebe2-91e2-479a-b705-d067e7d361b6"
          },
          {
            "name": "Ciclo Médio (dias)",
            "displayFolder": "P4 Ciclos",
            "expression": "AVERAGE(fato_item_contratado[dias_ciclo])",
            "formatString": "0.0",
            "lineageTag": "31f4aed4-c9af-4bd0-a30b-7aff0e1aa820"
          },
          {
            "name": "Ciclo Máximo (dias)",
            "displayFolder": "P4 Ciclos",
            "expression": "MAX(fato_item_contratado[dias_ciclo])",
            "formatString": "0",
            "lineageTag": "bea0f975-a43c-4ce1-8c0d-5faa629febae"
          },
          {
            "name": "Itens sem Ciclo",
            "displayFolder": "P4 Ciclos",
            "expression": "COUNTROWS(FILTER(fato_item_contratado,ISBLANK(fato_item_contratado[dias_ciclo])))",
            "formatString": "#,0",
            "lineageTag": "ab2d9aeb-deeb-4a4d-880c-6758a47407a8"
          },
          {
            "name": "Ciclos Válidos",
            "displayFolder": "P4 Ciclos",
            "expression": "COUNT(fato_item_contratado[dias_ciclo])",
            "formatString": "#,0",
            "lineageTag": "4875feef-f883-435c-a9ad-83f7a915e2a3"
          },
          {
            "name": "Ciclo Médio Elegível",
            "displayFolder": "P4 Ciclos",
            "expression": "IF([Ciclos Válidos]>=5,[Ciclo Médio (dias)])",
            "formatString": "0.0",
            "lineageTag": "46b9e875-7f3d-462d-8621-4d34b79a4206"
          },
          {
            "name": "Qtd Unidades Compradoras",
            "displayFolder": "P5 Território",
            "expression": "DISTINCTCOUNT(fato_item_contratado[sk_orgao])",
            "formatString": "#,0",
            "lineageTag": "b5dd7e94-450e-4fe4-b740-aac75d600027"
          },
          {
            "name": "Ticket Médio por Item",
            "displayFolder": "P6 Perfis",
            "expression": "DIVIDE([Volume Homologado],[Itens])",
            "formatString": "#,0.00",
            "lineageTag": "fe8b9a78-36f8-4065-a6b4-55e9c9d67750"
          },
          {
            "name": "Itens com Sobrepreço",
            "displayFolder": "P1 Economia",
            "expression": "COUNTROWS(FILTER(fato_item_contratado,fato_item_contratado[comparavel]=1 && fato_item_contratado[economia_valor]<0))",
            "formatString": "#,0",
            "lineageTag": "d8e8e198-2985-4e42-8b9e-9d9d0222d3d7"
          },
          {
            "name": "Volume por Homologação",
            "displayFolder": "Datas alternativas",
            "expression": "CALCULATE([Volume Homologado],USERELATIONSHIP(Calendario[Data],fato_item_contratado[data_homologacao]))",
            "formatString": "#,0.00",
            "lineageTag": "d34f2456-93c6-4da0-b939-fa8a75a47c81"
          },
          {
            "name": "Título Tooltip",
            "displayFolder": "Tooltip",
            "expression": "COALESCE(SELECTEDVALUE(dim_fornecedor[nome_fornecedor]),SELECTEDVALUE(dim_modalidade[nome_modalidade]),SELECTEDVALUE(dim_localidade[uf_sigla]),SELECTEDVALUE(fato_item_contratado[perfil_gasto]),\"Detalhes do recorte\")",
            "lineageTag": "72defc7d-55a2-41f2-95f8-f6ab1af2668b"
          },
          {
            "name": "Participação Top10 %",
            "displayFolder": "P2 Fornecedores",
            "expression": "DIVIDE([Volume Top10], CALCULATE([Volume Homologado], REMOVEFILTERS(dim_fornecedor)))",
            "formatString": "0.00%",
            "lineageTag": "959e40f0-321d-4776-bc82-b3210fc07dfe"
          },
          {
            "name": "Ciclos Elegíveis",
            "displayFolder": "P4 Ciclos",
            "expression": "IF([Ciclos Válidos]>=5,[Ciclos Válidos])",
            "formatString": "#,0",
            "lineageTag": "5d3d85a1-d855-47d9-b792-064505037312"
          },
          {
            "name": "Ciclo Máximo Elegível",
            "displayFolder": "P4 Ciclos",
            "expression": "IF([Ciclos Válidos]>=5,[Ciclo Máximo (dias)])",
            "formatString": "0",
            "lineageTag": "c19f68f1-b9fb-4779-a09e-5760ad5c0a36"
          }
        ],
        "partitions": [
          {
            "name": "Medidas",
