          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Medidas"
                    }
                  },
                  "Property": "Volume Homologado"
                }
              },
              "queryRef": "Medidas.Volume Homologado"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Medidas"
                    }
                  },
                  "Property": "Economia R$"
                }
              },
              "queryRef": "Medidas.Economia R$"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
