// Medidas explícitas do modelo PNCP

Valor Estimado Comparável =
CALCULATE(SUM(fato_item_contratado[valor_total_estimado]),fato_item_contratado[comparavel]=1)

Volume Homologado =
SUM(fato_item_contratado[valor_total_homologado])

Economia R$ =
VAR Estimado = [Valor Estimado Comparável]
VAR Homologado = CALCULATE([Volume Homologado],fato_item_contratado[comparavel]=1)
RETURN IF(ISBLANK(Estimado),BLANK(),Estimado-Homologado)

Economia % =
DIVIDE([Economia R$],[Valor Estimado Comparável])

Itens =
COUNTROWS(fato_item_contratado)

% Itens Comparáveis =
DIVIDE(CALCULATE([Itens],fato_item_contratado[comparavel]=1),[Itens])

Participação Fornecedor % =
DIVIDE([Volume Homologado],CALCULATE([Volume Homologado],REMOVEFILTERS(dim_fornecedor)))

Ranking Fornecedor =
RANKX(ALL(dim_fornecedor),[Volume Homologado],,DESC,Dense)

Concentração Top10 % =
VAR Top10 = TOPN(10,ALL(dim_fornecedor),[Volume Homologado],DESC,dim_fornecedor[ni_fornecedor],ASC)
VAR VolumeTop = CALCULATE([Volume Homologado],REMOVEFILTERS(dim_fornecedor),Top10)
VAR Total = CALCULATE([Volume Homologado],REMOVEFILTERS(dim_fornecedor))
RETURN DIVIDE(VolumeTop,Total)

Volume Top10 =
VAR Top10 = TOPN(10,ALL(dim_fornecedor),[Volume Homologado],DESC,dim_fornecedor[ni_fornecedor],ASC) RETURN CALCULATE([Volume Homologado],KEEPFILTERS(Top10))

Participação Volume % =
VAR Total = SWITCH(TRUE(),ISINSCOPE(dim_modalidade[nome_modalidade]),CALCULATE([Volume Homologado],REMOVEFILTERS(dim_modalidade)),ISINSCOPE(dim_localidade[uf_sigla]),CALCULATE([Volume Homologado],REMOVEFILTERS(dim_localidade[uf_sigla])),ISINSCOPE(dim_localidade[regiao]),CALCULATE([Volume Homologado],REMOVEFILTERS(dim_localidade)),ISINSCOPE(fato_item_contratado[perfil_gasto]),CALCULATE([Volume Homologado],REMOVEFILTERS(fato_item_contratado[perfil_gasto])),CALCULATE([Volume Homologado],REMOVEFILTERS())) RETURN DIVIDE([Volume Homologado],Total)

Deságio vs Média Geral pp =
VAR MediaGeral = CALCULATE([Economia %],REMOVEFILTERS()) RETURN IF(NOT ISBLANK([Economia %]),([Economia %]-MediaGeral)*100)

Ciclo Médio (dias) =
AVERAGE(fato_item_contratado[dias_ciclo])

Ciclo Máximo (dias) =
MAX(fato_item_contratado[dias_ciclo])

Itens sem Ciclo =
COUNTROWS(FILTER(fato_item_contratado,ISBLANK(fato_item_contratado[dias_ciclo])))

Ciclos Válidos =
COUNT(fato_item_contratado[dias_ciclo])

Ciclo Médio Elegível =
IF([Ciclos Válidos]>=5,[Ciclo Médio (dias)])

Qtd Unidades Compradoras =
DISTINCTCOUNT(fato_item_contratado[sk_orgao])

Ticket Médio por Item =
DIVIDE([Volume Homologado],[Itens])

Itens com Sobrepreço =
COUNTROWS(FILTER(fato_item_contratado,fato_item_contratado[comparavel]=1 && fato_item_contratado[economia_valor]<0))

Volume por Homologação =
CALCULATE([Volume Homologado],USERELATIONSHIP(Calendario[Data],fato_item_contratado[data_homologacao]))

Título Tooltip =
COALESCE(SELECTEDVALUE(dim_fornecedor[nome_fornecedor]),SELECTEDVALUE(dim_modalidade[nome_modalidade]),SELECTEDVALUE(dim_localidade[uf_sigla]),SELECTEDVALUE(fato_item_contratado[perfil_gasto]),"Detalhes do recorte")

Participação Top10 % =
DIVIDE([Volume Top10], CALCULATE([Volume Homologado], REMOVEFILTERS(dim_fornecedor)))

Ciclos Elegíveis =
IF([Ciclos Válidos]>=5,[Ciclos Válidos])

Ciclo Máximo Elegível =
IF([Ciclos Válidos]>=5,[Ciclo Máximo (dias)])

